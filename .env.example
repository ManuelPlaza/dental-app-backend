# Configuración de Base de Datos
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=dental_db
DB_PORT=5432

# O usar DATABASE_URL (Railway, Docker, etc.)
# DATABASE_URL=postgres://user:password@host:5432/dental_db?sslmode=disable

# Servidor
PORT=8080
GIN_MODE=release

# JWT - OBLIGATORIO: Generar con: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_at_least_32_chars_long

# CORS - Separar múltiples orígenes con comas
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
